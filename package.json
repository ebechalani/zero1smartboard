{
  "name": "zero1-smartboard-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser simulator for the ZERO1 Smart Board (Arduino UNO based educational board)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.1"
  }
}
